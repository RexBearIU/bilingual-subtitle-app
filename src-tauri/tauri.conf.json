{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Bilingual Subtitles",
  "version": "0.1.0",
  "identifier": "com.bilingualsubtitle.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bilingual Subtitles",
        "width": 900,
        "height": 220,
        "minWidth": 320,
        "minHeight": 80,
        "x": 220,
        "y": 760,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "shadow": false,
        "dragDropEnabled": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../asr_srv.py": "asr_srv.py",
      "../pyproject.toml": "pyproject.toml",
      "../uv.lock": "uv.lock",
      "binaries/uv.exe": "uv.exe"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["English"],
        "installMode": "currentUser"
      }
    }
  }
}
