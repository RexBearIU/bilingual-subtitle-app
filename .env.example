# Copy this file to `.env` and fill in your own values.
#
#     cp .env.example .env
#
# `.env` is gitignored. Real environment variables take priority over anything
# here, so `OPENROUTER_API_KEY=... cargo tauri dev` still overrides the file.
#
# The app looks for `.env` in, in order: $BILINGSUBS_ENV_FILE, the working
# directory, its parent (so `cargo tauri dev` from src-tauri/ finds the repo
# root copy), then the directory holding the executable.
#
# You can skip this file entirely and paste the key into Settings ⚙️ instead —
# it is then stored in %APPDATA%\com.bilingualsubtitle.app\settings.json.

# ── Translation (required for subtitles to be translated) ────────────────────

# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model slug. Subtitles are one or two sentences and latency is what you feel,
# so a small fast model beats a large one. Any slug from
# https://openrouter.ai/models works.
# Default when unset: google/gemini-2.5-flash-lite
OPENROUTER_MODEL=

# Point at a proxy or another OpenAI-compatible gateway.
# Default when unset: https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=

# Comma-separated upstream provider preference, e.g. to force a low-latency one.
OPENROUTER_PROVIDER_ORDER=

# ── ASR (all optional; Settings ⚙️ covers the common ones) ───────────────────

# HuggingFace repo id. Setting this OVERRIDES the model picker in Settings —
# leave it empty unless you want to pin a specific model.
WHISPER_MODEL=

# Port for the local asr_srv.py sidecar. Default: 9001
ASR_PORT=

# Directory holding cublas64_12.dll etc. for faster-whisper's CUDA backend.
# Only needed in dev when they are not next to the executable.
ASR_DLL_DIR=

# Python interpreter used to launch asr_srv.py. Default: `python` from PATH
PYTHON_BIN=
