# Copy this file to `.env` and fill in your own values.
#
#     cp .env.example .env
#
# `.env` is gitignored. Real environment variables take priority over anything
# here, so `OPENROUTER_API_KEY=... cargo tauri dev` still overrides the file.
#
# The app looks for `.env` in, in order: $BILINGSUBS_ENV_FILE, the working
# directory, its parent (so `cargo tauri dev` from src-tauri/ finds the repo
# root copy), then the directory holding the executable.
#
# You can skip this file entirely and paste the key into Settings ⚙️ instead —
# it is then stored in %APPDATA%\com.bilingualsubtitle.app\settings.json.

# ── Translation ──────────────────────────────────────────────────────────────
#
# Any endpoint speaking the OpenAI-compatible /chat/completions shape works.
# List providers in preference order: the worker starts on the first whose key
# is accepted, and falls forward to the next after two consecutive failures, so
# one provider rate-limiting you does not stop the subtitles.
#
# Presets (base URL + default model are built in — you only need the key):
#   aistudio    Google AI Studio    https://aistudio.google.com/apikey
#   openrouter  OpenRouter          https://openrouter.ai/keys
#   groq        Groq                https://console.groq.com/keys
#
# For any other endpoint, invent a name and set its _BASE_URL and _MODEL too.

TRANSLATE_PROVIDERS=aistudio,openrouter

# ── aistudio (Google) ──
# NOTE: do NOT enable billing on that Google Cloud project. The moment you do,
# the free tier disappears for it and every call is billed from the first token.
TRANSLATE_AISTUDIO_API_KEY=
# Google side uses bare model names — no `google/` prefix.
# Default when unset: gemini-3.5-flash-lite
TRANSLATE_AISTUDIO_MODEL=

# ── openrouter ──
TRANSLATE_OPENROUTER_API_KEY=
# Default when unset: google/gemini-3.5-flash-lite
TRANSLATE_OPENROUTER_MODEL=
# Comma-separated upstream preference, e.g. to force a low-latency provider.
# OpenRouter-specific; ignored by other endpoints.
TRANSLATE_OPENROUTER_PROVIDER_ORDER=

# Any provider also accepts an explicit base URL:
# TRANSLATE_<NAME>_BASE_URL=

# ── Legacy single-provider form ──────────────────────────────────────────────
# Still honoured, and still what the Settings panel writes. Used only when
# TRANSLATE_PROVIDERS is unset. The provider is named after whichever preset
# the base URL matches, so the logs stay truthful.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# OPENROUTER_BASE_URL=
# OPENROUTER_PROVIDER_ORDER=

# ── ASR (all optional; Settings ⚙️ covers the common ones) ───────────────────

# HuggingFace repo id. Setting this OVERRIDES the model picker in Settings —
# leave it empty unless you want to pin a specific model.
WHISPER_MODEL=

# Port for the local asr_srv.py sidecar. Default: 9001
ASR_PORT=

# Directory holding cublas64_12.dll etc. for faster-whisper's CUDA backend.
# Only needed in dev when they are not next to the executable.
ASR_DLL_DIR=

# Python interpreter used to launch asr_srv.py. Default: `python` from PATH
PYTHON_BIN=
